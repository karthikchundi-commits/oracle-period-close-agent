# Oracle Fusion Cloud
ORACLE_HOST=https://your-instance.fa.us2.oraclecloud.com
ORACLE_CLIENT_ID=your_client_id
ORACLE_CLIENT_SECRET=your_client_secret
ORACLE_TOKEN_URL=https://your-instance.fa.us2.oraclecloud.com/oauth/token
ORACLE_LEDGER_ID=1001
ORACLE_PERIOD_NAME=Jan-25

# LLM Provider: claude or openai
LLM_PROVIDER=claude

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Agent
AGENT_MAX_ITERATIONS=30
AGENT_VARIANCE_THRESHOLD_PCT=10.0

# Notifications
NOTIFICATION_CONTROLLER_EMAIL=controller@yourcompany.com
NOTIFICATION_SMTP_HOST=smtp.yourcompany.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_FROM_EMAIL=erp-agent@yourcompany.com
